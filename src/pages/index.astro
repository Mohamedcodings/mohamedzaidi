---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { SITE } from "@/site.config";
import { getSortedPosts } from "@/utils/posts";

const posts = (await getSortedPosts()).slice(0, 8);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="intro-section" aria-labelledby="intro-title">
    <div class="intro-identity">
      <img
        class="profile-photo"
        src="/images/profile.png"
        alt="Mohamed Zaidi"
        width="96"
        height="96"
        loading="eager"
        decoding="async"
      />
      <h1 id="intro-title">Notes on building.</h1>
    </div>
    <p class="intro-line">{SITE.headline}</p>
    <p class="intro-copy">{SITE.bio}</p>
    <SocialLinks />
  </section>

  <section class="section-block" aria-labelledby="latest-posts">
    <div class="section-heading">
      <h2 id="latest-posts">Latest Posts</h2>
    </div>
    <PostList posts={posts} />
    <a class="text-link" href="/posts">All Posts</a>
  </section>
</BaseLayout>
